rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Demo users collection
    match /demo_users/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Waitlist requests collection
    match /waitlist_requests/{document} {
      // Public can READ to check for duplicates (via query on their email)
      allow read: if true;

      // Public can CREATE new requests
      allow create: if request.resource.data.keys().hasAll([
                        'email', 'full_name', 'organization',
                        'role', 'use_case', 'status', 'submitted_at'
                       ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');

      // Admin can update and delete
      allow update, delete: if request.auth != null
                            && request.auth.token.admin == true;
    }

    // Catch-all: deny everything else (PUT THIS LAST!)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
